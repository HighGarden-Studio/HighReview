# HighReview Environment Configuration

# GitHub Authentication
# This app uses GitHub CLI (gh) for authentication.
# No OAuth configuration needed - just run: gh auth login

# Anthropic API Key (Required for AI Code Review)
# Get your API key from: https://console.anthropic.com/settings/keys
# Without this key, AI reviews will return fallback empty results
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Set port if you want to use a different port
# PORT=8765

# Default ports:
# - Frontend: http://localhost:5173
# - Backend: http://localhost:8765
